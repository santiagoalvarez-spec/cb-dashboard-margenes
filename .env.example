# Copia este archivo a .env y completa tus valores reales.
# .env NO debe ser commiteado al repositorio.

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Gmail (recomendado): usa una App Password, no tu contraseña normal.
# Genera una en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM_EMAIL=tu_cuenta@gmail.com
SMTP_FROM_NAME=Dashboard Márgenes
SMTP_USE_SSL=false

# ── Otros proveedores populares ───────────────────────────────────────────────
# Outlook / Microsoft 365:
#   SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASSWORD=<api_key>
# Amazon SES:
#   SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_PORT=587
